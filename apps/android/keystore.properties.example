# Copy to keystore.properties (git-ignored). Never commit the real file or the keystore.
# Create the upload key once:
#   keytool -genkeypair -v -keystore synclet-release.jks -alias synclet -keyalg RSA -keysize 4096 -validity 10000
# Keep synclet-release.jks backed up: Play only accepts updates signed with this upload key
# (Play App Signing manages the app signing key; a lost upload key can only be reset via Play support).
storeFile=synclet-release.jks
storePassword=
keyAlias=synclet
keyPassword=
# Optional: service account JSON for the Play Developer API (outside the repository)
# playCredentials=/Users/you/secrets/synclet-play.json
# Relative paths (storeFile, playCredentials, SYNCLET_KEYSTORE_FILE, SYNCLET_PLAY_CREDENTIALS) resolve against apps/android.
