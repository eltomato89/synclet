<?xml version="1.0" encoding="utf-8"?>
<!-- Nur Debug: Klartext (Emulator → http://10.0.2.2) und Nutzer-CAs für Tests. Release: Standard (nur HTTPS, System-CAs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
