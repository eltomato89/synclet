{
  "sourceLanguage": "en",
  "strings": {
    "%@ cannot be reached. Check the address and your connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. Prüfe die Adresse und deine Verbindung."
          }
        }
      }
    },
    "%lld local changes have not been uploaded yet and will be lost.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld local change has not been uploaded yet and will be lost."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld local changes have not been uploaded yet and will be lost."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld lokale Änderung wurde noch nicht hochgeladen und geht verloren."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld lokale Änderungen wurden noch nicht hochgeladen und gehen verloren."
                }
              }
