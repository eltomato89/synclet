        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Inhalte"
          }
        }
      }
    },
    "Pinned folders stay downloaded on this Mac, including new files. Everything else is downloaded when you open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Ordner bleiben samt neuer Dateien auf diesem Mac geladen. Alles andere wird beim Öffnen geladen."
          }
        }
      }
    },
    "Please allow Synclet in System Settings under General > Login Items & Extensions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte erlaube Synclet in den Systemeinstellungen unter „Allgemein > Anmeldeobjekte & Erweiterungen“."
          }
        }
      }
    },
    "Please enter a valid server address, e.g. files.example.com.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte gib eine gültige Serveradresse ein, z. B. files.example.com."
          }
        }
      }
    },
    "Quit Synclet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
