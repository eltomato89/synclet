    "Right-click a file or folder in Finder: “Download Now” loads it, “Remove Download” frees the space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke im Finder mit der rechten Maustaste auf eine Datei oder einen Ordner: „Jetzt laden“ lädt sie herunter, „Download entfernen“ gibt den Speicherplatz frei."
          }
        }
      }
    },
