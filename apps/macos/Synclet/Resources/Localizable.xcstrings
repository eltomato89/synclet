      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Team-Ordner"
          }
        }
      }
    },
    "The folder appears in the Finder sidebar under “Locations”. Files are downloaded when you open them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner erscheint im Finder in der Seitenleiste unter „Orte“. Dateien werden erst beim Öffnen heruntergeladen."
          }
        }
      }
    },
    "The folder could not be opened: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner konnte nicht geöffnet werden: %@"
          }
        }
      }
    },
    "The folders could not be loaded: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ordner konnten nicht geladen werden: %@"
          }
        }
      }
    },
    "The login item could not be changed: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der automatische Start konnte nicht geändert werden: %@"
          }
        }
      }
    },
    "The login window could not be opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anmeldefenster konnte nicht geöffnet werden."
          }
        }
      }
    },
    "The setting could not be saved: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellung konnte nicht gespeichert werden: %@"
          }
        }
      }
    },
    "The sign-in could not be verified. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung konnte nicht bestätigt werden. Bitte versuche es erneut."
          }
        }
      }
    },
    "The sign-in was refused (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde abgelehnt (%@)."
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        }
      }
    },
    "You sign in in the browser window that opens next.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung erfolgt im Browserfenster, das sich danach öffnet."
          }
        }
      }
    },
    "Your files appear in Finder under “Locations” afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien erscheinen danach im Finder unter „Orte“."
          }
        }
      }
    },
    "Your files stay on the server. The folder and the copies downloaded to this Mac are removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien bleiben auf dem Server erhalten. Der Ordner und die auf diesem Mac geladenen Kopien werden entfernt."
          }
        }
      }
    }
  },
  "version": "1.0"
}
