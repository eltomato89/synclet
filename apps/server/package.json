    "@nestjs/platform-fastify": "^11.0.0",
    "@parcel/watcher": "^2.5.0",
    "@prisma/client": "^6.0.0",
    "@synclet/shared": "workspace:*",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "fastify": "^5.0.0",
    "mime-types": "^3.0.0",
