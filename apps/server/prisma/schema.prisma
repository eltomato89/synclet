// Raw-SQL objects that are NOT modeled here (Prisma ignores them today, but check
// every generated migration for DROP statements touching them before applying it):
//   - extensions pg_trgm, unaccent
//   - function synclet_unaccent(text)            (20261015150737_phase_1b_core)
//   - index "Item_name_trgm_idx"   (GIN trigram, partial: live items)
//   - index "Item_owner_mtime_idx" (partial: live files)
//   - index "Item_contentHash_idx" (partial: live items)
//   - unique index "Item_owner_path_live_key"     (20261015131742_init, partial: live items)
// test/schema-drift.spec.ts asserts that migrations and this schema stay in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum ItemType {
  folder
  file
}

enum ChangeOp {
  upsert
  delete
}

/// Singleton row (id = 1) created on first start.
model ServerConfig {
  id        Int      @id @default(1)
  serverId  String   @db.Uuid
  jwtSecret String
  createdAt DateTime @default(now())
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  /// Folder name below the data root.
  username    String       @unique
  email       String?      @unique
  displayName String
  role        Role         @default(user)
  disabledAt  DateTime?
  /// Last successful login (password, OIDC, forward-auth, app login).
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  identities  Identity[]
  sessions    Session[]
  devices     SyncDevice[]
  items       Item[]
  scope       SyncScope?
  shareLinks  ShareLink[]
}

/// Login identities: provider 'local' (subject = username lower-case) or 'oidc:<issuer>' later.
model Identity {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  subject      String
  passwordHash String?
  createdAt    DateTime @default(now())

  @@unique([provider, subject])
}

/// Web refresh sessions (rotating, httpOnly cookie).
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model SyncDevice {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  platform       String
  appVersion     String
  installationId String?
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime?
  revokedAt      DateTime?

  @@index([userId])
}

/// Mirror of one file/folder on disk. Paths are relative to the user root, '/'-separated.
model Item {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @db.Uuid
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// null = direct child of the user root ("root").
  parentId    String?   @db.Uuid
  type        ItemType
  /// Exact on-disk name.
  name        String
  /// NFC + lower-case, for collision checks.
  nameKey     String
  path        String
  size        BigInt    @default(0)
  mtime       DateTime
  ino         BigInt?
  dev         BigInt?
  contentHash String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Tombstone; kept for tombstoneWindowSec so external moves can be paired.
  deletedAt   DateTime?
  /// Key of the last office editing session that saved this file.
  officeKey   String?

  @@index([ownerId, parentId])
  @@index([ownerId, dev, ino])
  @@index([ownerId, path])
}

/// Per-user journal head. seq is incremented inside the mutating transaction
/// (row lock => sequence numbers become visible in commit order, no gaps for readers).
model SyncScope {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seq    BigInt @default(0)
  /// Watermark: entries with seq <= minSeq were trimmed; older cursors get 410.
  minSeq BigInt @default(0)
}

model FileChange {
  scopeId  String   @db.Uuid
  seq      BigInt
  itemId   String   @db.Uuid
  itemType ItemType
  op       ChangeOp
  at       DateTime @default(now())

  @@id([scopeId, seq])
  @@index([scopeId, itemId])
  @@index([at])
}

model TrashEntry {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @db.Uuid
  itemId       String    @db.Uuid
  type         ItemType
  name         String
  originalPath String
  size         BigInt
  /// Absolute path below metaRoot/trash.
  storePath    String
  /// [{ id, type, path, name, mtime, size, contentHash }] of the subtree, for restore with original IDs.
  manifest     Json
  deletedAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@index([ownerId, deletedAt])
  @@index([expiresAt])
}

enum DerivativeKind {
  thumb
  text
}

enum JobStatus {
  pending
  running
  done
  failed
  unsupported
}

/// One derivative computation per content hash and kind (content-addressed; shared by copies).
model DerivativeJob {
  sha       String
  kind      DerivativeKind
  status    JobStatus      @default(pending)
  attempts  Int            @default(0)
  lastError String?
  /// e.g. { "sizes": [256, 1024], "poster": true, "width": 4032, "height": 3024 }
  meta      Json?
  lockedAt  DateTime?
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  @@id([sha, kind])
  @@index([status, kind])
}

/// Extracted plain text per content hash for full-text search (tsv maintained via raw SQL).
model ItemText {
  sha       String                   @id
  /// First 1 MiB of extracted text (snippets).
  content   String
  createdAt DateTime                 @default(now())
  /// Full-text vector, written only via raw SQL (TextIndexer.updateTsv). Modeled here so
  /// `prisma migrate dev` does not try to drop the column and its GIN index.
  tsv       Unsupported("tsvector")?

  @@index([tsv], type: Gin, map: "ItemText_tsv_idx")
}

model ShareLink {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique
  /// AES-256-GCM encrypted token (base64url iv.ciphertext.tag) so the owner can re-copy the link.
  tokenEnc      String
  itemId        String    @db.Uuid
  ownerId       String    @db.Uuid
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  passwordHash  String?
  expiresAt     DateTime?
  allowDownload Boolean   @default(true)
  allowUpload   Boolean   @default(false)
  revokedAt     DateTime?
  hits          Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([ownerId])
  @@index([itemId])
}

enum VersionSource {
  api
  office
  restore
}

/// Superseded content of a file (only when SYNCLET_VERSIONS=on). Follows the item id across moves.
model FileVersion {
  id        String        @id @default(uuid()) @db.Uuid
  itemId    String        @db.Uuid
  ownerId   String        @db.Uuid
  /// Item.version this content had while it was current.
  version   Int
  sha       String
  size      BigInt
  /// mtime of the content while it was current.
  mtime     DateTime
  /// When it was superseded (= version timestamp used by retention buckets).
  createdAt DateTime      @default(now())
  createdBy String?       @db.Uuid
  source    VersionSource
  /// Absolute path under <meta>/versions.
  storePath String

  @@index([itemId, createdAt])
  @@index([ownerId])
  @@index([sha])
}

/// One-time PKCE authorization codes for native app login (hash only).
model AppAuthCode {
  id            String    @id @default(uuid()) @db.Uuid
  codeHash      String    @unique
  userId        String    @db.Uuid
  clientId      String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

/// Singleton (id = 1): runtime auth settings edited in the admin UI.
model AuthSettings {
  id                        Int      @id @default(1)
  /// Disable password login for non-admin users (admins always keep it).
  passwordLoginForUsers     Boolean  @default(true)
  oidcEnabled               Boolean  @default(false)
  oidcIssuer                String?
  oidcClientId              String?
  /// SecretBox ciphertext (purpose "oidc-client-secret").
  oidcClientSecretEnc       String?
  oidcScopes                String   @default("openid profile email")
  oidcButtonLabel           String   @default("Single Sign-on")
  oidcUsernameClaim         String   @default("preferred_username")
  oidcGroupsClaim           String   @default("groups")
  oidcAllowedGroups         String[] @default([])
  oidcAdminGroups           String[] @default([])
  /// Attach an OIDC login to an existing account with the same verified email.
  oidcLinkByEmail           Boolean  @default(false)
  forwardAuthEnabled        Boolean  @default(false)
  forwardAuthUserHeader     String   @default("Remote-User")
  forwardAuthEmailHeader    String   @default("Remote-Email")
  forwardAuthNameHeader     String   @default("Remote-Name")
  forwardAuthGroupsHeader   String   @default("Remote-Groups")
  /// CIDRs of proxies allowed to set forward-auth headers (direct socket peer of the server).
  forwardAuthTrustedProxies String[] @default([])
  forwardAuthAdminGroups    String[] @default([])
  forwardAuthAllowedGroups  String[] @default([])
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?  @db.Uuid
}
