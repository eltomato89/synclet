# Debian 13 (libfuse 3.17) variant of the build image: SYNCLET_DISTRO=debian13 linux.sh dotnet test
FROM debian:trixie
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends ca-certificates curl libicu-dev fuse3 libfuse3-dev gcc libc6-dev pkg-config procps psmisc \
 && curl -sSL https://dot.net/v1/dotnet-install.sh | bash -s -- --channel 10.0 --install-dir /usr/share/dotnet \
 && ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet \
 && rm -rf /var/lib/apt/lists/*
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
