{
  "sourceLanguage": "en",
  "strings": {
    "%@ cannot be reached. Check the address and your connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. Prüfe die Adresse und deine Verbindung."
          }
        }
      }
    },
    "Accounts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten"
          }
        }
      }
    },
    "Add Account": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto hinzufügen"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Connect Synclet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synclet verbinden"
          }
        }
      }
    },
    "Connected as %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden als %@"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "No Synclet server at %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Synclet-Server unter %@"
          }
        }
      }
    },
    "Please enter a valid server address, e.g. files.example.com.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte gib eine gültige Serveradresse ein, z. B. files.example.com."
          }
        }
      }
    },
    "Server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        }
      }
    },
    "Sign In": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden"
          }
        }
      }
    },
    "Sign In Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu anmelden"
          }
        }
      }
    },
    "Sign Out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden"
          }
        }
      }
    },
    "Sign in again to reconnect %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich erneut an, um %@ wieder zu verbinden."
          }
        }
      }
    },
    "Sign in to your Synclet server to see your files here and in the Files app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei deinem Synclet-Server an, um deine Dateien hier und in der Dateien-App zu sehen."
          }
        }
      }
    },
    "Sign out %@?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abmelden?"
          }
        }
      }
    },
    "Sign-in required": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung erforderlich"
          }
        }
      }
    },
    "Signed in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet"
          }
        }
      }
    },
    "The login window could not be opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anmeldefenster konnte nicht geöffnet werden."
          }
        }
      }
    },
    "The sign-in could not be verified. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung konnte nicht bestätigt werden. Bitte versuche es erneut."
          }
        }
      }
    },
    "The sign-in was refused (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde abgelehnt (%@)."
          }
        }
      }
    },
    "You sign in in the browser window that opens next.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du meldest dich im Browserfenster an, das sich als Nächstes öffnet."
          }
        }
      }
    },
    "Your files are also available in the Files app under “Locations”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien findest du auch in der Dateien-App unter „Orte“."
          }
        }
      }
    },
    "Your files stay on the server. The copies on this device and changes that have not been uploaded are removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien bleiben auf dem Server. Die Kopien auf diesem Gerät und noch nicht hochgeladene Änderungen werden entfernt."
          }
        }
      }
    }
  },
  "version": "1.0"
}
