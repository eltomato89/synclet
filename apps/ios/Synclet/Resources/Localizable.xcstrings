      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet"
          }
        }
      }
    },
    "You are offline. Please try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Bitte versuche es später erneut."
          }
        }
      }
    },
    "You sign in in the browser window that opens next.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du meldest dich im Browserfenster an, das sich als Nächstes öffnet."
          }
        }
      }
    },
    "Your files are also available in the Files app under “Locations”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien findest du auch in der Dateien-App unter „Orte“."
          }
        }
      }
    },
    "Your files can only be browsed with a connection to the server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien können nur mit einer Verbindung zum Server angezeigt werden."
          }
        }
      }
    },
    "Your files stay on the server. The copies on this device and changes that have not been uploaded are removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien bleiben auf dem Server. Die Kopien auf diesem Gerät und noch nicht hochgeladene Änderungen werden entfernt."
          }
        }
      }
    }
  },
  "version": "1.0"
}
