{
  "name": "synclet",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:db": "docker compose -f deploy/compose.dev.yml up -d",
    "build": "pnpm -r build",
    "test": "pnpm -r --filter '!@synclet/e2e' test",
    "typecheck": "pnpm -r typecheck",
    "test:throwaway": "bash scripts/throwaway-test.sh",
    "test:e2e": "pnpm --filter @synclet/e2e test",
    "test:e2e:fresh": "bash scripts/e2e-fresh.sh"
  }
}
