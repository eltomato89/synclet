# Folder with your files. Each user gets a subfolder named like the username.
SYNCLET_DATA=/srv/files
# Required. Metadata (trash, later thumbnails/versions). Must exist, be writable by PUID:PGID
# and live OUTSIDE SYNCLET_DATA.
SYNCLET_META=/srv/synclet-meta
# Owner of the files on the host (id -u / id -g).
PUID=1000
PGID=1000
# Required. Embedded unescaped in DATABASE_URL: use only URL-safe characters [A-Za-z0-9._~-].
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Host ports for Caddy (HTTP / HTTPS).
# For automatic Let's Encrypt certificates you need SYNCLET_SITE_ADDRESS=<your domain>,
# SYNCLET_PORT=80 and SYNCLET_TLS_PORT=443, public DNS and reachable ports 80/443.
SYNCLET_PORT=8080
SYNCLET_TLS_PORT=8443
# Public URL, e.g. https://files.example.com (enables secure cookies)
SYNCLET_PUBLIC_URL=
# Set to your domain to let Caddy fetch TLS certificates, or keep :80 behind a proxy.
SYNCLET_SITE_ADDRESS=:80
# Behind another reverse proxy: the proxies Caddy may take the client IP (X-Forwarded-For) from,
# e.g. private_ranges or "192.168.1.10/32". Empty = trust none (all clients would then share one
# rate-limit bucket behind an outer proxy, because they all appear with the proxy's IP).
SYNCLET_TRUSTED_PROXIES=
# off = no file watcher, scan every 2 minutes instead (NFS/SMB sources)
SYNCLET_WATCH=on

# --- Optional tuning (empty = built-in default; see README "Configuration") ---
# Seconds between full scans (default 900 with the watcher, 120 with SYNCLET_WATCH=off).
#SYNCLET_SCAN_INTERVAL=
# Maximum upload size in bytes (default 53687091200 = 50 GiB).
#SYNCLET_MAX_UPLOAD_BYTES=
# Safety guard: refuse to delete the index of a user root that suddenly appears empty while it
# held more than this many top-level items (default 25, 0 = off). If you really emptied the
# folder, set it to 0, restart the server (docker compose ... up -d), then set it back.
#SYNCLET_MASS_DELETE_THRESHOLD=
# Seconds within which an item that vanished and reappears elsewhere is still recognised as a move
# (keeps its ID; default 3600). Tombstones are purged after max(this, 1 day).
#SYNCLET_TOMBSTONE_WINDOW=
# Days of sync-journal history kept (default 30).
#SYNCLET_JOURNAL_RETENTION_DAYS=
# Force the Secure flag on cookies on/off (default: on when SYNCLET_PUBLIC_URL starts with https://).
#SYNCLET_SECURE_COOKIES=
# Days deleted items stay in the trash before they are removed for good (default 30).
#SYNCLET_TRASH_RETENTION_DAYS=
# Postgres text search configuration for search: simple, german, english, ... (default simple = no
# stemming; invalid values fall back to simple with a warning). Server and worker use the same value.
# Changing it later does NOT re-index already extracted text: existing documents keep their old
# stemming until their content changes.
#SYNCLET_SEARCH_LANGUAGE=
# Parallel preview jobs in the worker container (default 2).
#SYNCLET_WORKER_CONCURRENCY=
# Files larger than this many bytes get no thumbnail/preview/text extraction (default 2147483648 = 2 GiB).
#SYNCLET_PREVIEW_MAX_BYTES=
