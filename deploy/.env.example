# Folder with your files. Each user gets a subfolder named like the username.
SYNCLET_DATA=/srv/files
# Required. Metadata (trash, later thumbnails/versions). Must exist, be writable by PUID:PGID
# and live OUTSIDE SYNCLET_DATA.
SYNCLET_META=/srv/synclet-meta
# Folder with the team folders (one subfolder per team space; default deploy/teams from the
# repository checkout). It must exist before the first start and be writable by PUID:PGID: a
# folder Docker creates itself is owned by root, and creating team folders then fails. External storages (NAS shares, other disks) are mounted below /storage in
# compose.yml; see the commented examples there.
#SYNCLET_TEAMS=/srv/teams
# Owner of the files on the host (id -u / id -g).
PUID=1000
PGID=1000
# Required. Embedded unescaped in DATABASE_URL: use only URL-safe characters [A-Za-z0-9._~-].
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Host ports for Caddy (HTTP / HTTPS). An "address:port" form such as 127.0.0.1:8080 publishes
# the port on that address only (recommended behind an outer proxy on the same host).
# For automatic Let's Encrypt certificates you need SYNCLET_SITE_ADDRESS=<your domain>,
# SYNCLET_PORT=80 and SYNCLET_TLS_PORT=443, public DNS and reachable ports 80/443.
SYNCLET_PORT=8080
SYNCLET_TLS_PORT=8443
# Public URL, e.g. https://files.example.com (enables secure cookies)
SYNCLET_PUBLIC_URL=
# Set to your domain to let Caddy fetch TLS certificates, or keep :80 behind a proxy.
SYNCLET_SITE_ADDRESS=:80
# Behind another reverse proxy: the proxies Caddy may take the client IP (X-Forwarded-For) from,
# e.g. "192.168.1.10/32" (the proxy's own address). Empty = trust none (all clients would then
# share one rate-limit bucket behind an outer proxy, because they all appear with the proxy's IP).
# Used for the client IP only; it never lets anyone send forward-auth headers.
SYNCLET_TRUSTED_PROXIES=
# Forward-auth only (see README "Forward-auth"): the exact address of the authenticating proxy
# (Authelia/Authentik gate), e.g. "192.168.1.10/32". Only this direct peer may send the identity
# headers (Remote-User/-Email/-Name/-Groups); Caddy strips them from everyone else. Empty (default)
# = always strip. NEVER use private_ranges or a whole subnet here: every host in it could sign in
# as any user, admins included. Also publish Caddy only on loopback (SYNCLET_PORT=127.0.0.1:8080,
# SYNCLET_TLS_PORT=127.0.0.1:8443) or firewall it, so clients can reach Synclet only through the proxy.
SYNCLET_FORWARD_AUTH_PROXIES=
# off = no file watcher, scan every 2 minutes instead (NFS/SMB sources)
SYNCLET_WATCH=on

# --- Optional tuning (empty = built-in default; see README "Configuration") ---
# Seconds between full scans (default 900 with the watcher, 120 with SYNCLET_WATCH=off).
#SYNCLET_SCAN_INTERVAL=
# Maximum upload size as a plain number of bytes, digits only (default 53687091200 = 50 GiB). Suffixes
# such as 50G are refused: the server does not start and the bundled Caddy cannot load its config. Enforced by the server and, as the
# request body limit for /api/*, by the bundled Caddy (an outer reverse proxy may need the same).
#SYNCLET_MAX_UPLOAD_BYTES=
# Safety guard: refuse to delete the index of a user root that suddenly appears empty while it
# held more than this many top-level items (default 25, 0 = off). If you really emptied the
# folder, set it to 0, restart the server (docker compose ... up -d), then set it back.
#SYNCLET_MASS_DELETE_THRESHOLD=
# Seconds within which an item that vanished and reappears elsewhere is still recognised as a move
# (keeps its ID; default 3600). Tombstones are purged after max(this, 1 day).
#SYNCLET_TOMBSTONE_WINDOW=
# Days of sync-journal history kept (default 30).
#SYNCLET_JOURNAL_RETENTION_DAYS=
# Force the Secure flag on cookies on/off (default: on when SYNCLET_PUBLIC_URL starts with https://).
#SYNCLET_SECURE_COOKIES=
# Days deleted items stay in the trash before they are removed for good (default 30).
#SYNCLET_TRASH_RETENTION_DAYS=
# Postgres text search configuration for search: simple, german, english, ... (default simple = no
# stemming; invalid values fall back to simple with a warning). Server and worker use the same value.
# Changing it later does NOT re-index already extracted text: existing documents keep their old
# stemming until their content changes.
#SYNCLET_SEARCH_LANGUAGE=
# Parallel preview jobs in the worker container (default 2).
#SYNCLET_WORKER_CONCURRENCY=
# Files larger than this many bytes get no thumbnail/preview/text extraction (default 2147483648 = 2 GiB).
#SYNCLET_PREVIEW_MAX_BYTES=

# --- File versions (optional; off by default) ---
# on = keep the previous content of a file whenever it is overwritten through Synclet (web, sync
# clients, Office). Versions live in SYNCLET_META/versions, never in SYNCLET_DATA. See README "Versions".
#SYNCLET_VERSIONS=off
# Per-user cap for stored version bytes, oldest first (default 0 = unlimited).
#SYNCLET_VERSIONS_MAX_BYTES=

# --- Single sign-on (optional; configured in the admin area, see README "Single sign-on") ---
# Emergency switch: 1 (or true/on/yes) = ignore OIDC/forward-auth and allow password login for everyone. Use it when
# SSO is misconfigured and nobody can log in; unset it again afterwards.
#SYNCLET_SSO_EMERGENCY=
# 1 = accept an http:// OIDC issuer on a loopback/private address (lab setups only; default: https required).
#SYNCLET_SSO_ALLOW_HTTP_ISSUER=

# --- Office (optional): Euro-Office Document Server on its own subdomain ---
# Needs ~4 GB RAM and a second DNS name pointing at this host (e.g. office.example.com).
# Start with (--build is required: the Caddy image contains the Caddyfile import for the office
# site; after upgrading an existing installation run it with --build once):
#   docker compose -f deploy/compose.yml -f deploy/compose.office.yml --env-file deploy/.env up -d --build
# Without compose.office.yml none of the variables below are used.
# Site address of the office site in Caddy: a domain (automatic Let's Encrypt, needs ports 80/443,
# same as SYNCLET_SITE_ADDRESS), or http://office.example.com behind a proxy that terminates TLS.
# Both sites share Caddy's port 80/443 and are told apart by the Host header, so an outer proxy
# must forward the original Host.
#SYNCLET_OFFICE_SITE_ADDRESS=office.example.com
# Browser-facing https URL of the Document Server (what users' browsers load the editor from).
# Must match the site above as seen from outside, e.g. https://office.example.com (no trailing
# slash). Caddy also adds this origin to the Content-Security-Policy of the Synclet site.
#SYNCLET_OFFICE_PUBLIC_URL=https://office.example.com
# Behind a TLS-terminating outer proxy SYNCLET_TRUSTED_PROXIES (above) must include that proxy,
# otherwise Caddy sends X-Forwarded-Proto http and the Document Server generates http:// URLs
# (mixed content, editor does not load).
# Required with the office override: shared JWT secret between Synclet and the Document Server.
# Generate one with: openssl rand -hex 32
#OFFICE_JWT_SECRET=
# Image tag of ghcr.io/euro-office/documentserver (default latest; pin it in production).
#OFFICE_TAG=latest
# The Document Server has its own file size limit: FileConverter.converter.maxDownloadBytes
# (default 524288000 = 500 MB) in /etc/euro-office/documentserver/default.json inside the office
# container (override via local.json); raise it there if you need to edit very large documents. Synclet's SYNCLET_MAX_UPLOAD_BYTES does not apply to it.
